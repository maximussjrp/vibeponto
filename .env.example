# Ambiente
DEBUG=true
ENVIRONMENT=development

# Banco de dados
DATABASE_URL=postgresql+asyncpg://vibeponto:vibeponto_dev_123@localhost:5432/vibeponto

# Redis
REDIS_URL=redis://:redis_dev_123@localhost:6379/0

# JWT
JWT_SECRET_KEY=dev_secret_key_change_in_production_123456789
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=vibeponto
STORAGE_REGION=us-east-1

# Celery
CELERY_BROKER_URL=amqp://vibeponto:rabbitmq_dev_123@localhost:5672//

# Geofencing
GEOFENCING_DEFAULT_RADIUS=100
GEOFENCING_DEFAULT_TOLERANCE=50

# AuditorIA
AUDITORIA_FACE_SIMILARITY_THRESHOLD=0.85
AUDITORIA_GEO_TOLERANCE_METERS=100
AUDITORIA_LIVENESS_THRESHOLD=0.80

# LGPD
LGPD_DATA_RETENTION_YEARS=5

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
