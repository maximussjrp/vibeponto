# Copy to .env.production and replace every value before running docker compose.
POSTGRES_USER=vibeponto
POSTGRES_PASSWORD=replace-with-random-postgres-password
POSTGRES_DB=vibeponto
REDIS_PASSWORD=replace-with-random-redis-password
RABBITMQ_DEFAULT_USER=vibeponto
RABBITMQ_DEFAULT_PASS=replace-with-random-rabbitmq-password
MINIO_ROOT_USER=vibeponto-storage
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
STORAGE_BUCKET=vibeponto
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_ENDPOINT=https://storage.vibeponto.com.br

# Backend security
ENVIRONMENT=production
DEBUG=false
APP_PUBLIC_URL=https://vibeponto.com.br
SECRET_KEY=replace-with-random-64-plus-character-secret
MFA_ENCRYPTION_KEY=replace-with-random-32-plus-character-secret
CORS_ORIGINS=["https://vibeponto.com.br","https://www.vibeponto.com.br"]
API_WORKERS=2
CELERY_WORKER_CONCURRENCY=2

# Transactional email. Keep disabled until SMTP/SendGrid/SES credentials are set.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
STRUCTURED_LOGGING=true
LOG_LEVEL=INFO
METRICS_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vibeponto-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10

# Frontend/browser-visible API URL
NEXT_PUBLIC_API_URL=https://vibeponto.com.br/api/v1

# Public reverse proxy and automatic TLS
SITE_DOMAIN=vibeponto.com.br
STORAGE_DOMAIN=storage.vibeponto.com.br
ACME_EMAIL=replace-with-your-operational-email
