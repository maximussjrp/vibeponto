# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE DESCARTÁVEL DE STAGING (.env.staging.example)
# ============================================================================
# NUNCA insira senhas reais de produção ou credenciais de clientes neste arquivo.
# Copie este arquivo para .env.staging e defina segredos locais descartáveis.

# PostgreSQL Staging
STAGING_POSTGRES_USER=postgres
STAGING_POSTGRES_PASSWORD=replace_with_staging_postgres_password
STAGING_POSTGRES_DB=test_vibeponto_staging

# Redis Staging
STAGING_REDIS_PASSWORD=replace_with_staging_redis_password

# MinIO Staging
STAGING_MINIO_USER=stagingstorage
STAGING_MINIO_PASSWORD=replace_with_staging_minio_password

# RabbitMQ Staging
STAGING_RABBITMQ_USER=stagingmq
STAGING_RABBITMQ_PASSWORD=replace_with_staging_rabbitmq_password

# API Staging
STAGING_SECRET_KEY=replace_with_staging_secret_key_min_32_chars_random
STAGING_MFA_ENCRYPTION_KEY=replace_with_staging_mfa_key_min_32_chars_random
ENVIRONMENT=staging
DEBUG=false
ALLOW_DESTRUCTIVE_TESTING=false

# Credenciais Sintéticas para Testes E2E
STAGING_ADMIN_EMAIL=staging_admin_e2e@staging.vibeponto.com
STAGING_ADMIN_PASSWORD=replace_with_synthetic_admin_password
STAGING_USER_EMAIL=staging_user_e2e@staging.vibeponto.com
STAGING_USER_PASSWORD=replace_with_synthetic_user_password
